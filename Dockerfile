# syntax=docker/dockerfile:1
# DesignCraft Web: publish an already-compiled, upstream-tagged static site.
# Rust/Trunk compilation happens once in GitHub Actions, before Docker Buildx.
# Build context: docker-context/ generated by .github/workflows/publish-image.yml
ARG NGINX_VERSION=1.28-alpine
FROM nginx:${NGINX_VERSION} AS runtime

ARG DESIGNCRAFT_COMMIT=""
ARG CRAFT_FONTS_COMMIT=""
ARG DESIGNCRAFT_VERSION=""

LABEL org.opencontainers.image.title="DesignCraft Web" \
      org.opencontainers.image.description="Community-maintained web build of DesignCraft" \
      org.opencontainers.image.source="https://github.com/MikaPST/designcraft-web" \
      org.opencontainers.image.url="https://github.com/MikaPST/designcraft-web" \
      org.opencontainers.image.version="${DESIGNCRAFT_VERSION}" \
      org.opencontainers.image.revision="${DESIGNCRAFT_COMMIT}" \
      io.mikapst.designcraft.craft-fonts-revision="${CRAFT_FONTS_COMMIT}"

# Replace the distribution's root nginx.conf with a non-root-safe configuration.
COPY nginx.conf /etc/nginx/nginx.conf
COPY site/ /usr/share/nginx/html/
COPY legal/ /usr/share/nginx/html/licenses/

# Port >1024 and /tmp runtime files allow the unprivileged nginx user.
USER nginx
EXPOSE 8080
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
